{
  "meta": {
    "name": "BS Phone iOS 27 Shell",
    "version": 1,
    "baseViewport": {
      "width": 390,
      "height": 844
    },
    "grid": 4
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 32,
    "8": 40,
    "9": 48,
    "10": 56,
    "11": 64
  },
  "layout": {
    "pageInline": 16,
    "pageBlock": 16,
    "navHeight": 48,
    "tabbarHeight": 56,
    "touchTarget": 44,
    "controlHeight": 44,
    "primaryButtonHeight": 48,
    "listRowMin": 64
  },
  "typography": {
    "largeTitle": 18,
    "pageTitle": 17,
    "body": 14,
    "caption": 11,
    "tab": 12,
    "weights": {
      "bold": 700,
      "semibold": 600
    }
  },
  "radius": {
    "control": 14,
    "button": 15,
    "card": 18,
    "sheet": 24
  },
  "motion": {
    "pageMs": 320,
    "sheetMs": 280,
    "pressMs": 100,
    "feedbackMs": 180,
    "easing": "cubic-bezier(.22,1,.36,1)"
  },
  "semanticColors": {
    "surface": "var(--card)",
    "textPrimary": "var(--fg)",
    "textSecondary": "var(--fg2)",
    "accent": "var(--accent)",
    "danger": "var(--danger)",
    "warning": "#ff9500",
    "success": "#188652"
  }
}
